// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // pgvector extension must be enabled manually at the DB level: CREATE EXTENSION IF NOT EXISTS vector;
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 사용자 취향 및 설정
  preferences UserPreferences?
  
  // 사용자 활동 기록
  interactions UserInteraction[]
  feedbacks    Feedback[]
  
  // 사용자 세션
  sessions Session[]

  @@map("users")
}

model UserPreferences {
  id                String @id @default(cuid())
  userId            String @unique
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 취향 카테고리
  favoriteCategories String[] // ["tech", "music", "food", "travel"]
  
  // 콘텐츠 타입 선호도
  preferredContentTypes String[] // ["video", "article", "image", "podcast"]
  
  // 탐험 vs 활용 비율 (0.0 ~ 1.0, 기본값 0.2 = 20% 탐험)
  explorationRate Float @default(0.2)
  
  // 필터링 설정
  excludeCategories String[] // 제외할 카테고리
  minContentLength  Int?     // 최소 콘텐츠 길이
  maxContentLength  Int?     // 최대 콘텐츠 길이
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

model Content {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String   @unique
  thumbnail   String?
  
  // 콘텐츠 메타데이터
  contentType ContentType
  category    String
  tags        String[]
  
  // 콘텐츠 특성
  language    String   @default("ko")
  duration    Int?     // 동영상/오디오 길이 (초)
  wordCount   Int?     // 텍스트 기반 콘텐츠의 단어 수
  
  // 소스 정보
  source      String   // "youtube", "blog", "news", "instagram" 등
  sourceId    String?  // 원본 플랫폼의 ID
  author      String?
  
  // 품질 및 인기도 지표
  qualityScore Float @default(0.5) // 0.0 ~ 1.0
  popularityScore Float @default(0.0) // 0.0 ~ 1.0
  
  // 상태
  isActive    Boolean  @default(true)
  isProcessed Boolean  @default(false) // AI 분석 완료 여부
  // Moderation / Safety flag (true = passed safety checks)
  isSafe      Boolean  @default(true)
  
  // Embedding vector (semantic representation). Empty list => not yet computed.
  embedding   Float[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 관계
  interactions UserInteraction[]
  feedbacks    Feedback[]
  recommendations Recommendation[]

  @@map("contents")
}

model UserInteraction {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  // 상호작용 타입
  type InteractionType
  
  // 상호작용 세부 정보
  duration    Int?     // 시청/읽기 시간 (초)
  progress    Float?   // 진행률 (0.0 ~ 1.0)
  timestamp   DateTime @default(now())
  
  // 컨텍스트 정보
  sessionId   String?
  referrer    String?
  userAgent   String?

  @@unique([userId, contentId, type, timestamp])
  @@map("user_interactions")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  // 피드백 타입
  type FeedbackType
  
  // 피드백 세부 정보
  rating     Int?     // 1-5점 평가
  comment    String?
  timestamp  DateTime @default(now())

  @@unique([userId, contentId, type])
  @@map("feedbacks")
}

model Recommendation {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  // 추천 점수 및 이유
  score     Float    // 0.0 ~ 1.0
  reason    String?  // 추천 이유 (AI 생성)
  
  // 추천 알고리즘 정보
  algorithm String   // "collaborative", "content-based", "exploration" 등
  
  // 상태
  isShown   Boolean  @default(false)
  isClicked Boolean  @default(false)
  
  createdAt DateTime @default(now())
  expiresAt DateTime? // 추천 만료 시간

  @@unique([userId, contentId])
  @@map("recommendations")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 세션 정보
  token     String   @unique
  userAgent String?
  ipAddress String?
  
  // 세션 상태
  isActive  Boolean  @default(true)
  expiresAt DateTime
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model OfflineMetric {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  // Store evaluation results as JSON, e.g. { "P@5":0.12, "P@10":0.08, "users":100 }
  metrics   Json
  note      String?

  @@map("offline_metrics")
}

// 열거형 정의
enum ContentType {
  VIDEO
  ARTICLE
  IMAGE
  PODCAST
  SOCIAL_POST
  NEWS
  BLOG
  OTHER
}

enum InteractionType {
  VIEW
  CLICK
  LIKE
  DISLIKE
  SHARE
  BOOKMARK
  COMPLETE
  SKIP
}

enum FeedbackType {
  LIKE
  DISLIKE
  RATING
  COMMENT
}
